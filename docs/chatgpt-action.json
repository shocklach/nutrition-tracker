{
  "openapi": "3.1.0",
  "info": {
    "title": "Nutrition Log",
    "description": "Appends a meal to a private nutrition log stored in GitHub.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://api.github.com" }],
  "paths": {
    "/repos/OWNER/REPO/dispatches": {
      "post": {
        "operationId": "logNutritionEntry",
        "summary": "Log one meal to the nutrition tracker",
        "description": "Records a single meal's estimated nutrition. Call this only when the user explicitly asks to log or save the meal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event_type", "client_payload"],
                "properties": {
                  "event_type": {
                    "type": "string",
                    "enum": ["log-entry"],
                    "default": "log-entry",
                    "description": "Always the literal string 'log-entry'."
                  },
                  "client_payload": {
                    "type": "object",
                    "required": [
                      "proteinGrams",
                      "calories",
                      "saturatedFatGrams",
                      "fiberGrams"
                    ],
                    "properties": {
                      "proteinGrams": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 500,
                        "description": "Total protein in grams, whole number."
                      },
                      "calories": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5000,
                        "description": "Total calories, whole number."
                      },
                      "saturatedFatGrams": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200,
                        "description": "Total saturated fat in grams, one decimal allowed."
                      },
                      "fiberGrams": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200,
                        "description": "Total fiber in grams, one decimal allowed."
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 200,
                        "description": "Short description of the meal, e.g. 'Chicken burrito bowl'."
                      },
                      "dateKey": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "description": "Only for backdating a meal. Omit for meals eaten today — the server fills in today's date in US Central time."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Meal accepted and queued for logging." }
        }
      }
    }
  }
}
